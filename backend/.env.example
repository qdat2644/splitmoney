# Database
# Local development remains SQLite. Do not delete dev.db during PostgreSQL prep.
DATABASE_URL="file:./dev.db"
# Optional future PostgreSQL examples:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zyra?schema=public"
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zyra_test?schema=public"
NODE_ENV="development"
PORT="5000"

# Authentication
JWT_SECRET="your_jwt_secret_here_make_it_long_and_random"

# AI Integration (Google Gemini)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash" # or gemini-1.5-pro

# Email Configuration (Resend password reset delivery)
# Leave RESEND_API_KEY empty in local/dev to use the no-send fallback.
RESEND_API_KEY=""
EMAIL_FROM="\"Zyra\" <no-reply@yourdomain.com>"

# Monitoring (Sentry)
# Leave SENTRY_DSN empty locally unless testing event delivery.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""

# Frontend Setup
FRONTEND_URL="http://localhost:5173"
CLIENT_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"
